# ==============================================================================
# Smart School Management and Academic Information System (SSMS)
# Environment Variables Configuration Template
# Target: Metti Secondary School, Godere Woreda, Majang Zone, Gambella, Ethiopia
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core & Security
# ------------------------------------------------------------------------------
# Generate a production key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-6^*!tk4plyau6o6s&l!u_%3o(yd!2ye7rl3y9-iv%q$))=x2o^

# Set DEBUG=False for production LAN deployment
DEBUG=False

# Comma-separated list of permitted hostnames or IP addresses
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,192.168.1.100

# Static IP address assigned to this server on the Metti Secondary School LAN
LAN_SERVER_IP=192.168.1.100

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# DB_ENGINE options: 'postgresql' (production standard) or 'sqlite3' (development fallback)
DB_ENGINE=postgresql
DB_NAME=smart_school_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. Security & Brute-Force Protection (Step 24)
# ------------------------------------------------------------------------------
# Number of consecutive failed login attempts before client IP is temporarily locked
LOGIN_MAX_ATTEMPTS=5

# Lockout duration in seconds (900 seconds = 15 minutes)
LOGIN_LOCKOUT_DURATION=900

# ------------------------------------------------------------------------------
# 4. Backup & Disaster Recovery (Step 17)
# ------------------------------------------------------------------------------
# Grandfather-Father-Son (GFS) retention counts
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# Optional absolute paths to PostgreSQL utilities (if not already in Windows PATH)
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\16\bin\pg_restore.exe
# PSQL_PATH=C:\Program Files\PostgreSQL\16\bin\psql.exe
