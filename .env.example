# Database Configuration
# Options for DB_ENGINE: 'postgresql' or 'sqlite3'
# Set to 'sqlite3' for initial local development until PostgreSQL server is installed.
# Set to 'postgresql' for production and standard PostgreSQL operation.
DB_ENGINE=sqlite3
DB_NAME=smart_school_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=5432
